# Copie para .env e ajuste. Em produção, TODOS os segredos precisam ser definidos.
FLASH_ENV=dev                      # production liga a trava de segredos fortes
FLASH_ENGINE=sface                 # sface | fake (fake só para testes/demonstração)
FLASH_SECRET=                      # >= 32 caracteres aleatórios (assina links e códigos)
FLASH_ADMIN_TOKEN=                 # >= 16 caracteres (acesso ao painel /admin)
FLASH_DEFAULT_TENANT=cbde
# FLASH_DATABASE_URL=postgresql+psycopg://flash:senha@db:5432/flash   # padrão: SQLite em data/
# FLASH_GOOGLE_CREDENTIALS_FILE=/run/secrets/google-service-account.json
FLASH_SEARCHES_PER_DAY=10
